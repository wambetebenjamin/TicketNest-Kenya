# ===========================================================================
# TicketNest Kenya — environment variables
# Copy to .env.local for local development, or configure in Vercel project
# settings for production. ALL secrets live in environment variables only.
# The platform runs in demo mode when integration keys are absent.
# ===========================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://ticketnest.co.ke

# --- Authentication (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
TICKET_QR_SECRET=separate-secret-for-signing-ticket-qr-tokens

# --- Google reCAPTCHA v3 (all user-facing forms) ---
# Site key is public (NEXT_PUBLIC_); secret is server-side ONLY.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- M-Pesa Daraja API (STK push for purchases, B2C for payouts) ---
MPESA_ENVIRONMENT=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://ticketnest.co.ke/api/mpesa/callback
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=

# --- Stripe (card payment fallback for international buyers) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Maps (venue maps + browse cluster map) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Vercel KV (cart sessions, newsletter, availability counters, orders) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Vercel Blob (event poster uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- Email (Nodemailer; ticket confirmations + 24h reminders) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TicketNest Kenya <tickets@ticketnest.co.ke>
SUPPORT_INBOX=support@ticketnest.co.ke

# --- WhatsApp Cloud API (ticket delivery + support) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
